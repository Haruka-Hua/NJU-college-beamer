% --- new components ---------------------------------------------------------
% NOTE: LaTeX does not restore the font when a group ends, so every title
% group below is followed by an explicit font reset -- otherwise the body
% would keep the bold accent face.
%
% \callout[<title>]{<body>}
% A tinted panel with a solid accent bar down the left edge.
\newcommand{\callout}[2][]{%
  \par\noindent
  % baseline at the top of the box, so the panel lines up with its neighbours
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \node[anchor=north west, fill=mainlight, rounded corners=2.5pt,
          inner xsep=0.46cm, inner ysep=0.26cm,
          text width=\dimexpr\linewidth-0.92cm\relax] (cal) at (0,0) {%
            \ifstrempty{#1}{}{%
              {\sffamily\bfseries\textcolor{maincolor}{#1}\par}%
              \normalfont\selectfont\vspace{0.12cm}}%
            #2};
    \fill[maincolor] ([xshift=0.06cm,yshift=0.07cm]cal.north west)
                     rectangle ([xshift=0.20cm,yshift=-0.07cm]cal.south west);
  \end{tikzpicture}%
  \par\vspace{0.25cm}%
}

% \stat{<label>}{<value>}
% A small tinted card: a bold accent label above a larger value.
\newcommand{\stat}[2]{%
  \par\noindent
  % baseline at the top of the box, so the panel lines up with its neighbours
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \node[anchor=north west, fill=mainlight, rounded corners=2.5pt,
          inner xsep=0.34cm, inner ysep=0.22cm,
          text width=\dimexpr\linewidth-0.68cm\relax] (st) at (0,0) {%
            {\sffamily\bfseries\textcolor{maincolor}{\footnotesize #1}\par}%
            \sffamily\mdseries\selectfont\vspace{0.10cm}%
            {\sffamily\fontsize{12}{14}\selectfont #2\par}};
  \end{tikzpicture}%
  \par\vspace{0.20cm}%
}

% \card{<number>}{<title>}{<body>}
% A numbered process card.
\newcommand{\card}[3]{%
  \par\noindent
  % baseline at the top of the box, so the panel lines up with its neighbours
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \node[anchor=north west, fill=mainlight, rounded corners=2.5pt,
          inner xsep=0.34cm, inner ysep=0.24cm,
          text width=\dimexpr\linewidth-0.68cm\relax] (cd) at (0,0) {%
            {\sffamily\bfseries\textcolor{maincolor}{\fontsize{11}{13}\selectfont
             #1\enspace #2}\par}%
            \sffamily\mdseries\selectfont\vspace{0.14cm}%
            {\sffamily #3\par}};
  \end{tikzpicture}%
  \par\vspace{0.20cm}%
}

% \keypoint{<text>}
% A bold accent sentence introduced by a hollow arrow.
\newcommand{\keypoint}[1]{%
  \par\noindent
  \begin{tikzpicture}[baseline=-0.55ex]
    \draw[maincolor, line width=0.9pt] (0,0) -- (0.60,0);
    \draw[maincolor, line width=0.9pt] (0.42,0.20) -- (0.72,0) -- (0.42,-0.20);
  \end{tikzpicture}\hspace{0.18cm}%
  {\sffamily\bfseries\color{maincolor}#1}%
  \par\vspace{0.18cm}%
}

% \thead{...} -- bold accent table header cell
\newcommand{\thead}[1]{{\sffamily\bfseries\color{maincolor}#1}}

% \zebra -- alternate table rows with a faint tint (call before \begin{tabular})
\newcommand{\zebra}{\rowcolors{2}{mainpaler}{white}}
