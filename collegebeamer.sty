% --- Chinese typesetting ---------------------------------------------------
% Load the CJK package for the engine in use and pick the first available
% CJK family.  Users can still override this in their own preamble with
% \setCJKmainfont / \setCJKsansfont (XeLaTeX) or \setmainjfont /
% \setsansjfont (LuaLaTeX).
%
% The font lookup is kept in a plain macro: fontspec's conditional must not
% be nested inside more than one user-level \if.
\newcommand{\collegeSetCJKmain}{%
  \IfFontExistsTF{Noto Serif CJK SC}{\setCJKmainfont{Noto Serif CJK SC}}{%
    \IfFontExistsTF{Source Han Serif SC}{\setCJKmainfont{Source Han Serif SC}}{%
      \IfFontExistsTF{SimSun}{\setCJKmainfont{SimSun}}{}%
    }%
  }%
}
\newcommand{\collegeSetCJKsans}{%
  \IfFontExistsTF{Noto Sans CJK SC}{\setCJKsansfont{Noto Sans CJK SC}}{%
    \IfFontExistsTF{Source Han Sans SC}{\setCJKsansfont{Source Han Sans SC}}{%
      \IfFontExistsTF{Microsoft YaHei}{\setCJKsansfont{Microsoft YaHei}}{}%
    }%
  }%
}
\newcommand{\collegeSetLuatexjaMain}{%
  \IfFontExistsTF{Noto Serif CJK SC}{\setmainjfont{Noto Serif CJK SC}}{%
    \IfFontExistsTF{Source Han Serif SC}{\setmainjfont{Source Han Serif SC}}{%
      \IfFontExistsTF{SimSun}{\setmainjfont{SimSun}}{}%
    }%
  }%
}
\newcommand{\collegeSetLuatexjaSans}{%
  \IfFontExistsTF{Noto Sans CJK SC}{\setsansjfont{Noto Sans CJK SC}}{%
    \IfFontExistsTF{Source Han Sans SC}{\setsansjfont{Source Han Sans SC}}{%
      \IfFontExistsTF{Microsoft YaHei}{\setsansjfont{Microsoft YaHei}}{}%
    }%
  }%
}

\newif\ifcollegeXeCJK
\newif\ifcollegeLuatexja
\newif\ifcollegeCJKok
\ifcollegeChinese
  \ifXeTeX\collegeXeCJKtrue\collegeCJKoktrue\fi
  \ifLuaTeX\collegeLuatexjatrue\collegeCJKoktrue\fi
\fi
\ifcollegeChinese
  \ifcollegeCJKok\else
    \PackageWarning{collegeBeamer}{%
      Chinese text needs XeLaTeX or LuaLaTeX -- recompile with xelatex}
  \fi
\fi

% The font lookup runs in a single boolean conditional: fontspec's own
% conditional must not sit inside more than one user-level \if.
\ifcollegeXeCJK
  \ifcsdef{ver@sty.xeCJK}{}{\RequirePackage{xeCJK}}
  \collegeSetCJKmain
  \collegeSetCJKsans
\fi

\ifcollegeLuatexja
  \ifcsdef{ver@sty.luatexja-fontspec}{}{\RequirePackage{luatexja-fontspec}}
  \collegeSetLuatexjaMain
  \collegeSetLuatexjaSans
\fi

% --- typeset & elements settings ---
% force 16:9 aspect ratio
\geometry{paperwidth=16cm,paperheight=9cm}

% Page geometry.  The deck this theme is modelled on runs very close to the
% paper edge, so the text block is wide and the margins are small.
\setbeamersize{text margin left=0.60cm, text margin right=0.60cm}

% Frames are top aligned by default, like the reference deck.  An explicit
% [c] or [b] on a frame still works.
\beamer@centeredfalse

% --- colour system ---
\definecolor{maincolor}{RGB}{\maincolorRGB}
\definecolor{inkcolor}{HTML}{2E2B2F}      % body text
\definecolor{mutedcolor}{HTML}{6C656E}    % secondary text, page numbers
\definecolor{airforceblue}{HTML}{2E5F7F} % secondary accent (kept for compatibility)

\colorlet{mainlight}{maincolor!8!white}   % panel background
\colorlet{mainpaler}{maincolor!5!white}   % zebra rows, code background
\colorlet{mainrule}{maincolor!30!white}   % hairlines and borders

% --- logo ---
\pgfdeclareimage[height=0.62cm]{colorlogo}{\colorlogoPath}
\pgfdeclareimage[height=0.62cm]{translogo}{\translogoPath}
\newcommand{\@makelogo}{translogo}
\ifcollegeColorLogo\relax
  \renewcommand{\@makelogo}{colorlogo}
\fi

% The small framed badge used in the running header.
\newcommand{\collegeLogobadge}{%
  \tikz[baseline=(badge.base)]{%
    \node[draw=maincolor, rounded corners=1.4pt, line width=0.35pt,
          inner sep=1.4pt, outer sep=0pt] (badge)
          {\pgfuseimage{\@makelogo}};}%
}

% --- fonts ---
\usefonttheme{serif}   % body text is serif; headings switch to sans below

\setbeamerfont{normal text}{size=\small}
\setbeamerfont{headline}{family=\sffamily, series=\bfseries, size=\fontsize{15}{17}}
\setbeamerfont{frametitle}{family=\sffamily, series=\bfseries, size=\fontsize{12}{14.5}}
\setbeamerfont{framesubtitle}{family=\sffamily, series=\mdseries, size=\fontsize{9.5}{12}}
\setbeamerfont{title}{family=\sffamily, series=\bfseries, size=\fontsize{20}{23}}
\setbeamerfont{subtitle}{family=\sffamily, series=\mdseries, size=\fontsize{12.5}{15}}
\setbeamerfont{author}{family=\sffamily, series=\mdseries, size=\fontsize{11}{13}}
\setbeamerfont{date}{family=\sffamily, series=\mdseries, size=\fontsize{9.5}{12}}
\setbeamerfont{block title}{family=\sffamily, series=\bfseries, size=\small}
\setbeamerfont{block body}{size=\small}
\setbeamerfont{footline}{family=\sffamily, size=\scriptsize}
\setbeamerfont{toc}{family=\sffamily}
\setbeamerfont{section in toc}{family=\sffamily, series=\bfseries, size=\normalsize}

% --- colours used by beamer ---
\setbeamercolor{normal text}{fg=inkcolor, bg=white}
\setbeamercolor{structure}{fg=maincolor}
\setbeamercolor{title}{fg=maincolor}
\setbeamercolor{alerted text}{fg=maincolor}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=black}
\setbeamercolor{headline}{fg=maincolor}
\setbeamercolor{frametitle}{fg=maincolor}
\setbeamercolor{framesubtitle}{fg=mutedcolor}
\setbeamercolor{footline}{fg=mutedcolor}
\setbeamercolor{background canvas}{bg=white}

% Switch between the light (white) and the dark (main colour) background.
\newcommand{\themecolor}[1]{
    \ifstrequal{#1}{colorbg}{
        \setbeamercolor{normal text}{fg=white, bg=maincolor}
        \setbeamercolor{structure}{fg=white}
        \setbeamercolor{background canvas}{bg=maincolor}
        \setbeamercolor{toc section}{fg=white}
        \setbeamercolor{toc section shaded}{fg=white!60!maincolor}
        \setbeamercolor{toc subsection}{fg=white}
        \setbeamercolor{toc subsection shaded}{fg=white!60!maincolor}
    }{
        \setbeamercolor{normal text}{fg=inkcolor, bg=white}
        \setbeamercolor{structure}{fg=maincolor}
        \setbeamercolor{background canvas}{bg=white}
        \setbeamercolor{toc section}{fg=maincolor}
        \setbeamercolor{toc section shaded}{fg=mutedcolor}
        \setbeamercolor{toc subsection}{fg=maincolor}
        \setbeamercolor{toc subsection shaded}{fg=mutedcolor}
    }
}
\themecolor{white} % default: white theme
% P.S. Beamer colors should be set in the preamble. It often works fine in the document itself, but NOT for normal text foreground. Thus \themecolor should only be called from the preamble

% no navigation symbols
\setbeamertemplate{navigation symbols}{}

% --- footline -------------------------------------------------------------
% Redefine this (after \usepackage{collegeBeamer}) to add a motto to the footer.
\providecommand{\collegeMotto}{}
\newcommand{\@footlinepayoff}{\collegeMotto}

% zero padded frame number, e.g. 04
\newcommand{\collegeFrameNumber}{%
  \ifnum\insertframenumber<10 0\fi\insertframenumber}

\setbeamertemplate{footline}{
    \begin{beamercolorbox}[wd=\paperwidth, ht=2.6ex, dp=1.3ex, rightskip=0.60cm]{footline}
    \usebeamerfont{footline}\hfill
    \ifstrempty{\@footlinepayoff}{}{\@footlinepayoff\hspace{1.4cm}}%
    \collegeFrameNumber
    \end{beamercolorbox}
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, makes footline transparent
    \ifstrempty{#1}{
        \renewcommand{\@footlinepayoff}{}
        \setbeamercolor{footline}{fg=mutedcolor, bg=}
    }{
        \renewcommand{\@footlinepayoff}{\collegeMotto}
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\footlinecolor{} % default: no footline bar

% --- running header --------------------------------------------------------
% The section number, zero padded to two digits (01, 02, ...).
% It lives in a macro on purpose: beamer scans frame bodies for '<' and would
% otherwise mistake the comparison below for an overlay specification.
\newcommand{\collegeSectionNumber}{%
  \ifnum\c@section<10 0\fi\insertsectionnumber}

% "03  Long-term sample" -- the section number and name, repeated on every
% slide, exactly like the reference deck.  Redefine \collegeRunningHead in
% your own preamble to change it.
\newcommand{\collegeRunningHead}{%
  \ifnum\c@section>0
    \collegeSectionNumber\enspace\secname
  \fi}

\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=0.95cm, dp=0.15cm,
                         leftskip=1.42cm, rightskip=0.60cm]{headline}%
    \llap{\raisebox{-0.14cm}[0pt][0pt]{\makebox[0.96cm][l]{\collegeLogobadge}}}%
    {\usebeamerfont{headline}\usebeamercolor[fg]{headline}\collegeRunningHead}%
  \end{beamercolorbox}%
  \nointerlineskip
  \hbox to \paperwidth{%
    \hskip1.42cm{\color{maincolor}\rule{\dimexpr\paperwidth-2.02cm\relax}{0.06cm}}\hss}%
}

% --- frame title ------------------------------------------------------------
% The frame title sits *under* the accent rule as a bold lead line, the way
% the reference deck uses its purple sentences.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vskip0.34cm
  \begin{beamercolorbox}[wd=\textwidth, leftskip=0pt, rightskip=0pt]{frametitle}%
    \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else%
      \par\vskip0.14cm
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
    \fi%
  \end{beamercolorbox}%
  \vskip0.26cm
}
\setbeamertemplate{frametitle continuation}{}

% --- blocks -----------------------------------------------------------------
\setbeamertemplate{blocks}[rounded]
\colorlet{mainstrong}{maincolor!16!white}   % highlighted panels
\setbeamercolor{block title}{fg=maincolor, bg=mainlight}
\setbeamercolor{block body}{fg=inkcolor, bg=mainlight}
\setbeamercolor{block title alerted}{fg=maincolor, bg=mainstrong}
\setbeamercolor{block body alerted}{fg=inkcolor, bg=mainstrong}
\setbeamercolor{block title example}{fg=maincolor, bg=mainpaler}
\setbeamercolor{block body example}{fg=inkcolor, bg=mainpaler}

% --- bullets ----------------------------------------------------------------
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\textcolor{maincolor}{\rule{0.45ex}{0.45ex}}}}
\setbeamertemplate{itemize subitem}{\textcolor{maincolor}{\textemdash}}
\setbeamertemplate{itemize subsubitem}{\textcolor{maincolor}{\ensuremath{\circ}}}

% --- table of contents ------------------------------------------------------
% The entries follow the current theme, so a table of contents stays readable
% both on a white page and on the solid colour section page.
\setbeamercolor{toc section}{fg=maincolor}
\setbeamercolor{toc section shaded}{fg=mutedcolor}
\setbeamercolor{toc subsection}{fg=maincolor}
\setbeamercolor{toc subsection shaded}{fg=mutedcolor}

% With the 'currentsection' option the current section uses the plain
% template (highlighted) and the others the shaded one (dimmed).
\setbeamertemplate{section in toc}{%
  \usebeamercolor[fg]{toc section}\bfseries
  \inserttocsectionnumber.\enspace\inserttocsection}
\setbeamertemplate{section in toc shaded}{%
  \usebeamercolor[fg]{toc section shaded}
  \inserttocsectionnumber.\enspace\inserttocsection}
\setbeamertemplate{subsection in toc}{%
  \usebeamercolor[fg]{toc subsection}\inserttocsubsection}
\setbeamertemplate{subsection in toc shaded}{%
  \usebeamercolor[fg]{toc subsection shaded}\inserttocsubsection}

% --- code blocks ------------------------------------------------------------
\definecolor{codegreen}{RGB}{101,218,120}
\definecolor{darkgreen}{RGB}{93,158,82}
\definecolor{darkyellow}{RGB}{245,194,105}
\definecolor{codegray}{HTML}{6C656E}
\definecolor{codepurple}{HTML}{7C5293}

\lstdefinestyle{mystyle}{
    % The listing has no frame of its own: the surrounding beamer block
    % provides the panel, which keeps it exactly on the text column.
    frame=none,
    commentstyle=\color{codegray}\itshape,
    keywordstyle=\color{maincolor}\bfseries,
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{airforceblue},
    basicstyle=\ttfamily\scriptsize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=6pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    % The line numbers need room on the left; the code is inset from the
    % edge of the surrounding panel.
    xleftmargin=14pt,
    xrightmargin=8pt,
}

\lstset{style=mystyle}

% --- code panel -------------------------------------------------------------
% A tinted panel for code listings.  Unlike a beamer block it lines up
% exactly with the text column, so it does not stick out past the accent
% rule.
\newenvironment{codepanel}[1]{%
  \par\noindent
  \begin{beamercolorbox}[wd=\textwidth,sep=0.30cm]{block body}%
    {\sffamily\bfseries\textcolor{maincolor}{#1}\par}%
    \vspace{0.12cm}%
}{%
  \end{beamercolorbox}%
  \par\vspace{0.20cm}%
}

% --- section & frame setting ------------------------------------------------
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% Background for the divider pages: a soft diagonal gradient in the main
% colour, with the campus line drawing faded into the bottom right corner.
\newcommand{\collegeGradientBackground}{%
  \begin{tikzpicture}[remember picture, overlay]
    \shade[left color=maincolor, right color=maincolor!68!black, shading angle=305]
      (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}%
}

\newcommand{\collegeDividerBackground}{%
  \begin{tikzpicture}[remember picture, overlay]
    \shade[left color=maincolor, right color=maincolor!68!black, shading angle=305]
      (current page.south west) rectangle (current page.north east);
    \node[anchor=south east, inner sep=0pt, opacity=0.26] at
      ([xshift=0.5cm,yshift=0.25cm]current page.south east)
      {\includegraphics[height=5.6cm]{\sectionartPath}};
  \end{tikzpicture}%
}

% section page with the current section highlighted
\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \setbeamertemplate{headline}{}
    \themecolor{colorbg}
    \setbeamertemplate{background}{\collegeDividerBackground}
    % Expand the padded section number here: beamer scans frame bodies for
    % '<' and would read the comparison as an overlay specification.
    \ifnum\c@section<10 \def\collegeSectionPad{0}\else\def\collegeSectionPad{}\fi
    \edef\collegeSectionNumber{\collegeSectionPad\insertsectionnumber}
    \begin{frame}[plain]{}
        \vspace{0.45cm}
        {\color{white}\sffamily\bfseries\fontsize{11}{13}\selectfont \tocStr\par}
        \vspace{0.35cm}
        {\color{white}\sffamily\bfseries\fontsize{34}{38}\selectfont
         \collegeSectionNumber\par}
        \vspace{0.15cm}
        {\color{white}\sffamily\bfseries\fontsize{18}{22}\selectfont\secname\par}
        \vspace{0.45cm}
        \begin{minipage}{0.86\textwidth}
          \color{white}
          \tableofcontents[currentsection]
        \end{minipage}
    \end{frame}
    \endgroup
}

% subsection title page
\AtBeginSubsection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \setbeamertemplate{headline}{}
    \themecolor{colorbg}
    \setbeamertemplate{background}{\collegeDividerBackground}
    \begin{frame}[plain]{}
        \vspace*{1.9cm}
        {\color{white!60!maincolor}\sffamily\bfseries\fontsize{12}{15}\selectfont
         \thesection\enspace\secname\par}
        \vspace{0.34cm}
        {\color{white}\sffamily\bfseries\fontsize{26}{30}\selectfont
         \thesection.\thesubsection\enspace\subsecname\par}
    \end{frame}
    \endgroup
}

% --- title page --------------------------------------------------------------
% The title page is drawn entirely on the page canvas: a solid main-colour
% background, the school badge, the title block and the artwork.

\newcommand{\collegeTitlePage}{%
  \begin{tikzpicture}[x=1cm, y=-1cm, overlay]
    % badge
    \node[anchor=north west, inner sep=0pt] at (0.57,0.52)
      {\includegraphics[height=0.68cm]{\translogoPath}};
    % title block: one flowing column, so a two-line title still works
    \node[anchor=north west, inner sep=0pt, align=left, text width=8.4cm]
      at (1.20,2.00) {%
        {\sffamily\bfseries\fontsize{20}{24}\selectfont
         \textcolor{white}{\inserttitle}\par}%
        \vspace{0.24cm}%
        {\sffamily\mdseries\fontsize{12.5}{16}\selectfont
         \textcolor{white!88!maincolor}{\insertsubtitle}\par}%
        \vspace{0.34cm}%
        {\color{white}\rule{7.35cm}{0.45pt}}\par
        \vspace{0.32cm}%
        {\sffamily\mdseries\fontsize{11}{14}\selectfont
         \textcolor{white}{\insertauthor}\par}%
        \vspace{0.16cm}%
        {\sffamily\mdseries\fontsize{9.5}{12}\selectfont
         \textcolor{white!82!maincolor}{\insertdate}\par}};
    % artwork
    \collegeTitleArt
  \end{tikzpicture}%
}

\renewcommand{\maketitle}{%
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{headline}{}
        \setbeamercolor{background canvas}{bg=maincolor}
        \begin{frame}[plain]
            \AddToShipoutPictureFG*{%
              \AtPageUpperLeft{\collegeTitlePage}%
            }%
        \end{frame}
    \endgroup
}

