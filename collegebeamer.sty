\ProvidesPackage{collegeBeamer}
% ---------------------------------------------------------------------------
%  collegeBeamer -- a Beamer theme for universities, in the visual language of
%  the Nanjing University deck (solid main-colour title pages, a running
%  header with the section number, a thick accent rule, tinted panels).
%
%  Usage:  \usepackage[<college>,<lang>]{collegeBeamer}
%           \usepackage[nju,zh]{collegeBeamer}   % Chinese, needs XeLaTeX
% ---------------------------------------------------------------------------

% required packages
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{listings}
\RequirePackage{graphicx}
\RequirePackage{geometry}
\RequirePackage{amsfonts, amsmath, bm, oldgerm}  % math
\RequirePackage{verbatim}
\RequirePackage{animate}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{array}
\RequirePackage{iftex}
\RequirePackage{eso-pic}

% --- Latin fonts ----------------------------------------------------------
% With XeTeX/LuaLaTeX we can use the same serif / grotesque pairing as the
% reference deck; pdfLaTeX falls back to Latin Modern.
\newif\ifcollegeUnicodeEngine
\ifXeTeX\collegeUnicodeEnginetrue\else
  \ifLuaTeX\collegeUnicodeEnginetrue\else\fi
\fi
\ifcollegeUnicodeEngine
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  \IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{}
  \IfFontExistsTF{TeX Gyre Heros}{\setsansfont{TeX Gyre Heros}}{}
  \IfFontExistsTF{TeX Gyre Cursor}{\setmonofont{TeX Gyre Cursor}}{}
\else
  \RequirePackage{lmodern}
\fi

